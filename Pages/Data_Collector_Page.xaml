<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Vidi_Health.Pages.App_enter"
             Title=""
             BackgroundColor="BlanchedAlmond">

    <Grid RowDefinitions="Auto,*,Auto" Padding="24">

        <!-- PROGRESS BAR -->
        <StackLayout Grid.Row="0" Margin="0,20,0,0">
            <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="6">
                <BoxView x:Name="Step1Bar" Grid.Column="0" HeightRequest="4" CornerRadius="2" BackgroundColor="White"/>
                <BoxView x:Name="Step2Bar" Grid.Column="1" HeightRequest="4" CornerRadius="2" BackgroundColor="#FFFFFF55"/>
                <BoxView x:Name="Step3Bar" Grid.Column="2" HeightRequest="4" CornerRadius="2" BackgroundColor="#FFFFFF55"/>
                <BoxView x:Name="Step4Bar" Grid.Column="3" HeightRequest="4" CornerRadius="2" BackgroundColor="#FFFFFF55"/>
            </Grid>
            <Label x:Name="StepLabel"
                   Text="1 / 4"
                   TextColor="#FFFFFF99"
                   FontSize="12"
                   HorizontalOptions="End"
                   Margin="0,6,0,0"/>
        </StackLayout>

        <!-- CARDS -->
        <Grid Grid.Row="1" VerticalOptions="Center">

            <!-- STEP 1: İsim -->
            <Border x:Name="Card1"
                    BackgroundColor="LightYellow"
                    StrokeShape="RoundRectangle 24"
                    Stroke="Transparent"
                    Padding="28,36"
                    IsVisible="True">
                <VerticalStackLayout Spacing="20">
                    <Label Text="👋 Merhaba!"
                           FontSize="28"
                           FontAttributes="Bold"
                           TextColor="{StaticResource Primary}"/>
                    <Label Text="Sizi tanımak için birkaç soru soracağız."
                           FontSize="15"
                           TextColor="{StaticResource Gray500}"/>
                    <Label Text="İsminiz nedir?"
                           FontSize="17"
                           FontAttributes="Bold"
                           TextColor="{StaticResource Gray900}"
                           Margin="0,12,0,0"/>
                    <Border StrokeShape="RoundRectangle 12"
                            Stroke="Black"
                            StrokeThickness="2"
                            Padding="14,0"
                            HeightRequest="52">
                        <Entry x:Name="NameEntry"
                               MaxLength="50"
                               Placeholder="Adınızı girin"
                               PlaceholderColor="{StaticResource Black}"
                               FontSize="15"
                               BackgroundColor="White"
                               TextColor="Black"/>
                    </Border>
                </VerticalStackLayout>
            </Border>

            <!-- STEP 2: Cinsiyet -->
            <Border x:Name="Card2"
                    BackgroundColor="LightYellow"
                    StrokeShape="RoundRectangle 24"
                    Stroke="Transparent"
                    Padding="28,36"
                    IsVisible="False">
                <VerticalStackLayout Spacing="20">
                    <Label Text="⚧ Cinsiyet"
                           FontSize="28"
                           FontAttributes="Bold"
                           TextColor="{StaticResource Primary}"/>
                    <Label Text="Formüller cinsiyete göre değişmektedir."
                           FontSize="15"
                           TextColor="{StaticResource Gray500}"/>
                    <Border StrokeShape="RoundRectangle 12"
                            Stroke="Black"
                            StrokeThickness="2"
                            Padding="14,0"
                            HeightRequest="52"
                            Margin="0,12,0,0">
                        <Picker x:Name="GenderPicker"
                                FontSize="15"
                                BackgroundColor="Transparent"
                                TextColor="Black">
                            <Picker.ItemsSource>
                                <x:Array Type="{x:Type x:String}">
                                    <x:String>Erkek</x:String>
                                    <x:String>Kadın</x:String>
                                </x:Array>
                            </Picker.ItemsSource>
                        </Picker>
                    </Border>
                </VerticalStackLayout>
            </Border>

            <!-- STEP 3: Etnik Köken -->
            <Border x:Name="Card3"
                    BackgroundColor="LightYellow"
                    StrokeShape="RoundRectangle 24"
                    Stroke="Transparent"
                    Padding="28,36"
                    IsVisible="False">
                <VerticalStackLayout Spacing="20">
                    <Label Text="🌍 Etnik Köken"
                           FontSize="28"
                           FontAttributes="Bold"
                           TextColor="{StaticResource Primary}"/>
                    <Label Text="Hesaplamalar etnik kökene göre farklılık gösterebilir."
                           FontSize="15"
                           TextColor="{StaticResource Gray500}"/>
                    <Border StrokeShape="RoundRectangle 12"
                            Stroke="Black"
                            StrokeThickness="2"
                            Padding="14,0"
                            HeightRequest="52"
                            Margin="0,12,0,0">
                        <Picker x:Name="EthnicityPicker"
                                FontSize="15"
                                BackgroundColor="Transparent"
                                TextColor="Black">
                                
                            <Picker.ItemsSource>
                                <x:Array Type="{x:Type x:String}">
                                    <x:String>Kafkas</x:String>
                                    <x:String>Asya</x:String>
                                    <x:String>Afrika</x:String>
                                    <x:String>Hispanik</x:String>
                                    <x:String>Orta Doğu</x:String>
                                    <x:String>Yerli Amerikan</x:String>
                                    <x:String>Pasifik Adaları</x:String>
                                    <x:String>Güney Asya</x:String>
                                    <x:String>Doğu Asya</x:String>
                                    <x:String>Karışık</x:String>
                                </x:Array>
                            </Picker.ItemsSource>
                        </Picker>
                    </Border>
                </VerticalStackLayout>
            </Border>

            <!-- STEP 4: Doğum Tarihi -->
            <Border x:Name="Card4"
                    BackgroundColor="LightYellow"
                    StrokeShape="RoundRectangle 24"
                    Stroke="Transparent"
                    Padding="28,36"
                    IsVisible="False">
                <VerticalStackLayout Spacing="20">
                    <Label Text="🎂 Doğum Tarihi"
                           FontSize="28"
                           FontAttributes="Bold"
                           TextColor="{StaticResource Primary}"/>
                    <Label Text="Yaşınız hesaplamalarda kullanılacaktır."
                           FontSize="15"
                           TextColor="{StaticResource Gray500}"/>
                    <Border StrokeShape="RoundRectangle 12"
                            Stroke="Black"
                            StrokeThickness="2"
                            Padding="14,0"
                            HeightRequest="52"
                            Margin="0,12,0,0">
                        <DatePicker x:Name="BirthDatePicker"
                                    Format="dd/MM/yyyy"
                                    BackgroundColor="Transparent"
                                    FontSize="15"
                                    TextColor="Black"/>
                    </Border>
                </VerticalStackLayout>
            </Border>

        </Grid>

        <!-- BOTTOM BUTTONS -->
        <Grid Grid.Row="2"
              ColumnDefinitions="Auto,*"
              Margin="0,0,0,24"
              ColumnSpacing="12">

            <Button x:Name="BackButton"
                    Grid.Column="0"
                    Text="←"
                    Clicked="OnBackClicked"
                    BackgroundColor="DimGrey"
                    TextColor="White"
                    FontSize="20"
                    CornerRadius="14"
                    WidthRequest="56"
                    HeightRequest="56"
                    IsVisible="False"/>

            <Button x:Name="NextButton"
                    Grid.Column="1"
                    Text="Devam Et"
                    Clicked="OnNextClicked"
                    BackgroundColor="White"
                    TextColor="{StaticResource Primary}"
                    FontAttributes="Bold"
                    FontSize="16"
                    CornerRadius="14"
                    HeightRequest="56"/>
        </Grid>

    </Grid>
</ContentPage>