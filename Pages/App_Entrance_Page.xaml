<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             x:Class="Vidi_Health.MainPage"
             BackgroundColor="BlanchedAlmond"
             Title="">

    <Grid RowDefinitions="*,Auto">

        <!-- CENTER: Animation Area + Buttons -->
        <ScrollView Grid.Row="0">
            <VerticalStackLayout
                VerticalOptions="Center"
                HorizontalOptions="Center"
                Spacing="16"
                Padding="32,40">

                <!-- Animation Placeholder -->
                <Border
                    WidthRequest="260"
                    HeightRequest="260"
                    StrokeShape="RoundRectangle 20"
                    Stroke="{StaticResource Gray200}"
                    StrokeThickness="1"
                    BackgroundColor="Transparent"
                    HorizontalOptions="Center">
                    <!-- Lottie veya custom animation buraya gelecek -->
                </Border>

                <!-- Google Button -->
                <Button
                    Text="Google ile Giriş Yap"
                    Clicked="OnGoogleLoginClicked"
                    BackgroundColor="#FFFFFF"
                    TextColor="#3C3C3C"
                    BorderColor="#DADADA"
                    BorderWidth="1"
                    CornerRadius="12"
                    FontSize="15"
                    HeightRequest="52"
                    WidthRequest="300"
                    HorizontalOptions="Center"/>

                <!-- Apple Button -->
                <Button
                    Text="Apple ile Giriş Yap"
                    Clicked="OnAppleLoginClicked"
                    BackgroundColor="#000000"
                    TextColor="#FFFFFF"
                    CornerRadius="12"
                    FontSize="15"
                    HeightRequest="52"
                    WidthRequest="300"
                    HorizontalOptions="Center"/>

                <!-- Manual Login Label -->
                <Label
                    HorizontalOptions="Center"
                    Margin="0,8,0,0">
                    <Label.FormattedText>
                        <FormattedString>
                            <Span Text="Hesabın var mı? "/>
                            <Span Text="Giriş yap"
                                  TextColor="{StaticResource Primary}"
                                  FontAttributes="Bold"
                                  TextDecorations="Underline">
                                <Span.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnManualLoginTapped"/>
                                </Span.GestureRecognizers>
                            </Span>
                        </FormattedString>
                    </Label.FormattedText>
                </Label>

            </VerticalStackLayout>
        </ScrollView>

        <!-- BOTTOM: Warning Label -->
        <Label
            Grid.Row="1"
            Text="Kişisel bilgileriniz cihazınızda kullanılmak üzere kayıt tutulacaktır"
            FontSize="12"
            HorizontalOptions="Center"
            HorizontalTextAlignment="Center"
            TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray500}}"
            Margin="24,0,24,20"/>

    </Grid>

</ContentPage>