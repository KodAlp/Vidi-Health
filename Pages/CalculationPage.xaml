<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Vidi_Health.Pages.CalculationPage"
             Title="CalculationPage">
    <ScrollView>
    <VerticalStackLayout>
            <Picker x:Name="MethodPicker"
                    HeightRequest= "36"
                    HorizontalOptions="Start"
                    WidthRequest="300">
                <Picker.ItemsSource>
                    <x:Array Type= "{x:Type x:String}">
                        <x:String>Jackson Pollock 3</x:String>
                        <x:String>Jackson Pollock 7</x:String>
                        <x:String>Navy Seal</x:String>
                    </x:Array>
                </Picker.ItemsSource>
            </Picker>
            
            
    </VerticalStackLayout>
    </ScrollView>
</ContentPage>